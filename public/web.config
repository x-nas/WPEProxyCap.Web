<?xml version="1.0" encoding="utf-8"?>
<!--
  部署到 IIS 时的静态托管配置（放在 web/public/，构建时由 Vite 复制到 wwwroot 根）。
  作用：默认文档 index.html；入口 no-cache、带 hash 的 assets 长缓存，保证前端更新即时生效。
  说明：本文件仅在 IIS 托管时生效；WebView2 本地虚拟主机加载会忽略它。
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- 确保 MIME 正确（remove 不存在项无害，防重复注册报 500） -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>

  <!-- index.html 不缓存：前端一更新即时生效 -->
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- 带 hash 的静态资源长缓存（一年 + immutable） -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
